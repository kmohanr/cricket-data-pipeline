{
  "environment": "TEST_WALLETPAY",
  "splunk_log_file": "logs/test/splunk/airflow_lob_pipeline.log",
  "grafana_metrics_file": "logs/test/grafana_metrics/walletpay_pipelines.prom",
  "oracle_sim_db": "data/test/oracle_walletpay_test.db",
  "incident_dir": "logs/test/incidents",
  "pipelines": [
    {
      "lob": "WALLET_TXN",
      "dag_id": "dag_wallet_hourly_txn_load",
      "frequency": "hourly",
      "target_table": "WALLET_TEST.FACT_HOURLY_TXN",
      "sla_seconds": 120,
      "min_expected_rows": 50
    },
    {
      "lob": "MERCHANT_SETTLEMENT",
      "dag_id": "dag_merchant_daily_settlement",
      "frequency": "daily",
      "target_table": "SETTLEMENT_TEST.FACT_DAILY_SETTLE",
      "sla_seconds": 300,
      "min_expected_rows": 100
    },
    {
      "lob": "COMPLIANCE_AUDIT",
      "dag_id": "dag_compliance_weekly_recon",
      "frequency": "weekly",
      "target_table": "AUDIT_TEST.AGG_WEEKLY_RECON",
      "sla_seconds": 600,
      "min_expected_rows": 75
    },
    {
      "lob": "FINANCE_LEDGER",
      "dag_id": "dag_finance_monthly_close",
      "frequency": "monthly",
      "target_table": "FINANCE_TEST.SUM_MONTHLY_LEDGER",
      "sla_seconds": 900,
      "min_expected_rows": 200
    }
  ]
}
